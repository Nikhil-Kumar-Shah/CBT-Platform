# Application Environment (development / production)
APP_ENV=production
APP_NAME="CBT Platform API"
APP_DEBUG=false

# Database Configuration (PostgreSQL / Azure PostgreSQL)
# The application automatically connects to POSTGRES_BOOTSTRAP_DATABASE (default: postgres)
POSTGRES_HOST=your-postgres-host.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_BOOTSTRAP_DATABASE=postgres
POSTGRES_DATABASE=cbt
POSTGRES_SSLMODE=require

# Or alternatively via unified SQLAlchemy DATABASE_URL:
# DATABASE_URL=postgresql+psycopg://postgres_user:your_secure_password_here@your-postgres-host.postgres.database.azure.com:5432/cbt?sslmode=require

# Security & Session Secrets
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_secure_random_string_in_production
SESSION_COOKIE_NAME=cbt_admin_session
SESSION_DURATION=86400
# In production, SESSION_COOKIE_SECURE defaults to true when APP_ENV=production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Rate Limiting (Abuse Prevention - requests per minute per client IP)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CODE_VERIFY_PER_MINUTE=30
RATE_LIMIT_ATTEMPT_START_PER_MINUTE=15

# CORS Configuration (Restricted in production - DO NOT use '*')
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://cbt.yourdomain.com

# Media & Storage (Azure Blob Storage or local volume)
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=cbt-media
LOCAL_STORAGE_DIR=backend/media

# Automated Database Backup Configuration
# BACKUP_DIR can be a mounted separate volume or storage path
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

