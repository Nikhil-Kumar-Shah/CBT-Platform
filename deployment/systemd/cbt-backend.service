[Unit]
Description=CBT Platform FastAPI Backend Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=Nikhil-VM
Group=Nikhil-VM
WorkingDirectory=/opt/cbt
Environment="PATH=/opt/cbt/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/cbt/.env
ExecStart=/opt/cbt/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips="127.0.0.1"

Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbt-backend

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cbt/logs

[Install]
WantedBy=multi-user.target
