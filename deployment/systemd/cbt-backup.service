[Unit]
Description=CBT Platform Automated PostgreSQL Database Backup
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=Nikhil-VM
Group=Nikhil-VM
WorkingDirectory=/opt/cbt
Environment="PATH=/opt/cbt/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/cbt/.env
ExecStart=/opt/cbt/.venv/bin/python3 /opt/cbt/scripts/backup_db.py

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cbt/backups /opt/cbt/logs
