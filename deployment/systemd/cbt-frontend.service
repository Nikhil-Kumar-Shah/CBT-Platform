[Unit]
Description=CBT Platform Next.js Frontend Service
After=network.target cbt-backend.service
Wants=cbt-backend.service

[Service]
Type=simple
User=Nikhil-VM
Group=Nikhil-VM
WorkingDirectory=/opt/cbt/frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=127.0.0.1"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbt-frontend

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cbt/frontend/.next /opt/cbt/logs

[Install]
WantedBy=multi-user.target
