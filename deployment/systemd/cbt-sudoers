# ==============================================================================
# CBT Platform — Minimal Non-Root Sudoers Permissions for Nikhil-VM
# Location: /etc/sudoers.d/cbt
# Mode: 0440
# ==============================================================================
# Grants Nikhil-VM minimal necessary privileges to control CBT systemd service units,
# inspect system journals, and test NGINX configuration without interactive password.
# ==============================================================================

Nikhil-VM ALL=(ALL) NOPASSWD: /bin/systemctl start cbt-backend, /bin/systemctl stop cbt-backend, /bin/systemctl restart cbt-backend, /bin/systemctl reload cbt-backend, /bin/systemctl status cbt-backend
Nikhil-VM ALL=(ALL) NOPASSWD: /bin/systemctl start cbt-frontend, /bin/systemctl stop cbt-frontend, /bin/systemctl restart cbt-frontend, /bin/systemctl reload cbt-frontend, /bin/systemctl status cbt-frontend
Nikhil-VM ALL=(ALL) NOPASSWD: /bin/systemctl start nginx, /bin/systemctl stop nginx, /bin/systemctl restart nginx, /bin/systemctl reload nginx, /bin/systemctl status nginx
Nikhil-VM ALL=(ALL) NOPASSWD: /bin/systemctl daemon-reload
Nikhil-VM ALL=(ALL) NOPASSWD: /usr/sbin/nginx -t, /usr/bin/nginx -t
Nikhil-VM ALL=(ALL) NOPASSWD: /bin/journalctl -u cbt-backend*, /bin/journalctl -u cbt-frontend*
Nikhil-VM ALL=(ALL) NOPASSWD: /usr/bin/fuser -k *
